{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "AI0FY",
  "version": "1.0.0",
  "identifier": "com.ai0fy.desktop",
  "build": {
    "frontendDist": "",
    "devUrl": "https://ai0fy.vercel.app",
    "beforeDevCommand": "",

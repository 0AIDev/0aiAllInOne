# ============================================================
# AI0FY — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai0fy?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai0fy?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Authentication ---
JWT_SECRET="change-me-to-a-random-64-char-string"
CRON_SECRET="change-me-to-another-random-string"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI0FY"

# --- Encryption (for provider keys at rest) ---
PROVIDER_KEY_ENCRYPTION_SECRET="change-me-to-a-256-bit-key-base64"

# --- Rate Limiting ---
DEFAULT_RATE_LIMIT_REQUESTS_PER_MINUTE=60
DEFAULT_RATE_LIMIT_TOKENS_PER_DAY=1000000
HARD_QUOTA_BUFFER_PERCENT=10

# --- Gateway ---
GATEWAY_TIMEOUT_MS=120000
MAX_CONCURRENT_CONNECTIONS=500
MAX_BODY_SIZE_BYTES=52428800
